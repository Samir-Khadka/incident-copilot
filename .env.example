# Copy to .env and fill in. Never commit a real .env.
DATABASE_URL=postgresql+psycopg://copilot:copilot@localhost:5432/copilot
GITHUB_WEBHOOK_SECRET=change-me-to-a-long-random-string

# Week 3 — restore checker Telegram alerts (optional; the check records its
# result event even when these are unset). Get the token from @BotFather,
# the chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Week 4 — docker compose stack (all optional; defaults in compose work for local dev)
POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot
POSTGRES_DB=copilot
# Bot + collectors talk to the API over the compose network; override only for host runs
COPILOT_API_URL=http://localhost:8000
